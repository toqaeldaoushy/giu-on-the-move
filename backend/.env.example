# Copy this file to ".env" and fill it in. NEVER share the .env file or commit it to Git.

# Supabase: in the dashboard click "Connect" (top bar), choose "Session pooler", copy the URI,
# then replace [YOUR-PASSWORD] with the database password you saved when you created the project.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres

# Any long random text. It signs the login tokens. Change it, and keep it private.
JWT_SECRET=change-me-to-a-long-random-text

PORT=3000

# Demo clock: the simulated data says "now" is Thursday 8 Oct 2026, 13:40 (the 13:45 trip has not left yet).
# Remove this line to use the real time.
SIMULATED_NOW=2026-10-08T13:40:00

# Password given to every demo user by "npm run seed:credentials" (development only).
DEV_PASSWORD=demo1234
